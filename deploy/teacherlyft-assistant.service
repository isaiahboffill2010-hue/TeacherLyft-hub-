[Unit]
Description=TeacherLyft Assistant local web server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=teacherlyft
Group=teacherlyft
WorkingDirectory=/opt/teacherlyft-assistant
EnvironmentFile=/opt/teacherlyft-assistant/.env.local
Environment=NODE_ENV=production
ExecStart=/usr/bin/npm run start -- --hostname 127.0.0.1 --port 3000
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/teacherlyft-assistant

[Install]
WantedBy=multi-user.target
