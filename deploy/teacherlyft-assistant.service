[Unit]
Description=TeacherLyft Assistant local web server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=teacherlyft
Group=teacherlyft
WorkingDirectory=/opt/teacherlyft-assistant
EnvironmentFile=/etc/teacherlyft-assistant.env
Environment=NODE_ENV=production
Environment=NEXT_TELEMETRY_DISABLED=1
ExecStartPre=/usr/bin/test -f /opt/teacherlyft-assistant/.next/BUILD_ID
ExecStart=/usr/bin/npm run start -- --hostname 127.0.0.1 --port 3000
Restart=always
RestartSec=5
TimeoutStopSec=20
KillSignal=SIGTERM
UMask=0077
StateDirectory=teacherlyft-assistant
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/teacherlyft-assistant
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
